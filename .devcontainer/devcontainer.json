{
  // Run the full Site Lab (Python engine + React app) in GitHub Codespaces, from the browser.
  // First start: installs Python and npm dependencies and builds the app (a few minutes). The first run of the
  // app then downloads and processes the open data once (about 400 MB, mostly When2Heat), which takes a while;
  // later starts are quick.
  "name": "Site Lab (emsbench)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postCreateCommand": "pip install -e '.[dev]' && cd web/app && npm ci && npm run build",
  "postAttachCommand": { "site-lab": "emsbench-app" },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Site Lab", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-python.python", "charliermarsh.ruff"] }
  }
}
